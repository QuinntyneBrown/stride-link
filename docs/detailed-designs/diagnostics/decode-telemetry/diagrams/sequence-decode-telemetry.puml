@startuml
title UML sequence behaviour — Decode and show telemetry
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Stride tester" as actor
box "Frontend — Stride Link UI layer" #E0F2FE
  participant "TelemetryPanel" as panel
end box
box "Frontend — Stride Link session core" #D1FADF
  participant "RunController" as run
  participant "TelemetryState" as state
end box
box "Frontend — Stride Link protocol module" #ECFDF3
  participant "TelemetryDecoder" as dec
end box
run -> dec : decode(parsed, variant)
alt malformed or unrelated kind
  dec --> run : empty update
else supported telemetry kind
  alt D3, length >= 5
    dec -> dec : speedKmh = ((b3 << 8) | b4) / 1000 (L2-028)
  else D2, length >= 4
    dec -> dec : incline = b3 (L2-030)
  else D1
    opt Stride 4 and length >= 9
      dec -> dec : speedKmh = ((b7 << 8) | b8) / 100 (L2-029)
    end
    opt length >= 12 and b11 > 0, either variant
      dec -> dec : heartRateBpm = b11 (L2-031)
    end
  end
  dec --> run : combined update with all decoded fields
end
note right of dec : D1 speed and heart rate are independent checks.
A zero heart-rate byte omits that field.
run -> state : apply(update)
note over state : Apply defined fields, including zero speed and incline.
Omitted fields preserve their last value.
alt any value changed
  state -> panel : render(state) within 100 ms (L2-032)
  panel --> actor : "3.00 km/h", "5", "72 bpm"; dash before the first value
end
note over state : No staleness timeout: the Stride sends speed and incline only on change (L2-032).\nreset() at the start of each run.
@enduml
