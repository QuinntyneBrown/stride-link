@startuml
title UML sequence behaviour — Bluetooth blocked on a page opened from disk
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Stride tester" as actor
box "Frontend — Stride Link UI layer" #E0F2FE
  participant "ConnectPanel" as panel
end box
box "Frontend — Stride Link session core" #D1FADF
  participant "RunController" as run
  participant "PacketLog" as log
end box
box "Frontend — Stride Link Bluetooth adapter" #FFF4E5
  participant "BluetoothGateway" as gateway
end box
box "External — Chrome or Edge" #F2F4F7
  participant "navigator.bluetooth" as bt
end box
actor -> panel : Press Connect
panel -> run : connect()
run -> gateway : requestTreadmill()
gateway -> bt : requestDevice(options)
bt --> gateway : reject SecurityError
gateway --> run : SecurityError
run -> log : record EV error name and message (L2-004)
run -> panel : showSupport(BlockedFromDisk)
panel --> actor : L2-004 text plus link to BuildInfo.hostedUrl
@enduml
